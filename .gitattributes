# The corpus stores the pages exactly as they were fetched/extracted: no
# end-of-line normalisation, no smudge/clean filters.
corpus/**/*.html -text
corpus/**/*.md   -text
sources/**       -text

# Binary artefacts
*.sqlite3 binary
*.tar.gz  binary

# Generated data (diff noise, language statistics)
data/index/**   linguist-generated=true
data/reports/** linguist-generated=true

# The corpus is an archive of third-party (Microsoft) documentation.
corpus/** linguist-vendored
sources/** linguist-vendored
