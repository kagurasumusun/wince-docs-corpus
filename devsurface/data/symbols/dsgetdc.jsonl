": "Pointer to a PDOMAIN_CONTROLLER_INFO value that receives a pointer to a DOMAIN_CONTROLLER_INFO structure that contains data about the domain controller selected. This structure is allocated by DsGetDcName . The caller must free the structure using the NetApiBufferFree function when it is no longer required. Note In Windows CE, the DomainControllerAddress is always returned as NULL, even on successful discoveries.", "direction": "out", "documented_values": [], "evidence_status": "derived+documented", "name": "DomainControllerInfo", "position": 6, "type": "PDOMAIN_CONTROLLER_INFO*", "type_raw": "PDOMAIN_CONTROLLER_INFO* DomainControllerInfo"}], "parse": {"model": "c_declarator_v1", "notes": [], "status": "parsed"}, "return_type": "DWORD", "schema_version": 1, "scope": null, "source": {"document_last_updated": null, "page_id": "aa450367", "page_path": "docs/mslearn/windows-ce-5.0/aa450367.html", "source_id": "mslearn-windows-ce-5.0", "source_url": "https://learn.microsoft.com/en-us/previous-versions/windows/embedded/aa450367(v=msdn.10)"}, "symbol": "DsGetDcName", "tag_name": null, "title_symbol": "DsGetDcName", "title_symbol_matches_declaration": true, "uncertainty": {"notes": [], "unknown_fields": ["abi.architecture", "abi.data_model", "calling_convention", "export.decorated_name", "export.name", "export.ordinal", "module"]}, "version_availability": {"statements": [{"field": "os_versions", "label_raw": "OS Versions", "normalized": {"family_id": "windows-ce", "family_label": "Windows CE", "generation": "ce-5.x", "qualifier": "and later", "release_suffix": null, "status": "mapped", "version_id": "windows-ce-5.0", "version_number": "5.0"}, "value_raw": "Windows CE 5.0 and later."}, {"field": "header", "label_raw": "Header", "normalized": {"family_id": null, "family_label": null, "generation": null, "qualifier": null, "release_suffix": null, "status": "unmapped", "version_id": null, "version_number": null}, "value_raw": "Dsgetdc.h."}, {"field": "library", "label_raw":