tus": "derived", "name": null, "position": 2, "type": "unsigned int uiId", "type_raw": "unsigned int uiId"}, {"description": "If uiOp is set to OBEX_RESP_ABORT, OBEX_RESP_ACCEPT, OBEX_RESP_CONTINUE, OBEX_RESP_DENY, OBEX_RESP_OK, or OBEX_RESP_REJECT, the value of pCommand is set to NULL. If uiOp is set to OBEX_RESP_DISCONNECT, OBEX_RESP_HANGUP, or OBEX_RESP_RESPOND, pCommand will contain an OBEXCOMMAND structure with the following specific values (all other values are the same as in a standard OBEXCOMMAND structure). Member Description uiOp The value of this member must match the value of the original command. sPktData The value of this member depends on the semantics of the command. fFinal The value of this member must be TRUE.", "direction": null, "documented_values": [{"description": "The value of this member must match the value of the original command.", "token": "uiOp"}, {"description": "The value of this member depends on the semantics of the command.", "token": "sPktData"}, {"description": "The value of this member must be TRUE.", "token": "fFinal"}], "evidence_status": "documented", "name": "pCommand", "position": 3, "type": "struct _obex_command *", "type_raw": "struct _obex_command * pCommand"}, {"declaration_match": false, "description": "The operation selector (the response that the server extension sends to the service extension). The following response values do not require the server extension to generate a command; all of these values would cause the OBEX server to format and send the given response back to the client. Value Description OBEX_RESP_ABORT The extension process was aborted. OBEX_RESP_ACCEPT The extension process was accepted. OBEX_RESP_CONTINUE The extension process can continue. OBEX_RESP_DENY The extension process was denied. OBEX_RESP_OK The extension process was successfully complete. OBEX_RESP_REJECT The extension process was rejected. The following response values require the server extension to genera", "direction": null, "documented_values": [{"description": "The extension process was aborted.", "token": "OBEX_RESP_ABORT"}, {"description": "The extension process was accepted.", "token": "OBEX_RESP_ACCEPT"}, {"description": "The extension process can continue.", "token": "OBEX_RESP_CONTINUE"}, {"description": "The extension process was denied.", "token": "OBEX_RESP_DENY"}, {"description": "The extension process was successfully complete.", "token": "OBEX_RESP_OK"}, {"description": "The extension process was rejected.", "token": "OBEX_RESP_REJECT"}, {"description": "Closes the current connection. When the service extension receives a disconnection request, the server extension must return this value.", "token": "OBEX_RESP_DISCONNECT"}, {"description": "Closes the current connection and the physical connection to the client. This value should only be used if client authentication fails or if the service extension detects a security attack. Closing the physical connection affects all logical connections on the same physical connection.", "token": "OBEX_RESP_HANGUP"}, {"description": "Generates a custom response; usually used when data is sent. This value requires an explicit command to be present in the function call parameters.", "token": "OBEX_RESP_RESPOND"}], "evidence_status": "documented", "name": "uiOp", "position": null, "type": null, "type_raw": null}, {"declaration_match": false, "description": "The transaction ID to which the OBEX server is responding.", "direction": null, "documented_values": [], "evidence_status": "documented", "name": "uiId", "position": null, "type": null, "type_raw": null}], "parse": {"model": "c_declarator_v1", "notes": ["unnamed_parameter:1", "unnamed_parameter:2"], "status": "parsed"}, "return_type": "int", "schema_version": 1, "scope": null, "source": {"document_last_updated": null, "page_id": "ms900565", "page_path": "docs/mslearn/windows-ce-5.0/ms900565.html", "source_id": "mslearn-windows-ce-5.0", "source_url": "https://learn.microsoft.com/en-us/previous-v