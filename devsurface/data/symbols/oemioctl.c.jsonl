{"abi": {"architecture": [], "data_model": null, "evidence_status": "unknown", "name_decoration": null, "packing": null, "structure_layout": null}, "calling_convention": {"evidence_status": "unknown", "value": null}, "compaction": "v1", "declaration": "BOOL OEMIoControl ( DWORD dwIoControlCode , LPVOID lpInBuf , DWORD nInBufSize , LPVOID lpOutBuf , DWORD nOutBufSize , LPDWORD lpBytesReturned );", "declaration_calling_convention_tokens": [], "declaration_glued_identifier_raw": null, "declaration_language": "c", "declaration_origin": "chm_syntax_pre", "declaration_status": "matched", "deprecation_statements": [], "derived_tags": [], "documentation_role": "declaration_section", "documented_export_tokens": [], "enumerators": [], "evidence": [{"detail": "declaration, requirements block, parameter list read mechanically from the page", "locator": "requirements+declaration"}], "export": {"decorated_name": null, "evidence_status": "unknown", "name": null, "ordinal": null}, "extraction": {"corpus_revision": "57016c7d8", "extracted_on": "2026-09-25", "tool_version": "1.0.0"}, "header": {"evidence_status": "documented", "label_raw": "Defined in", "value": "Oemioctl.c", "value_raw": "Oemioctl.c"}, "id": "sym-ee8526b1df28c398", "include": null, "kind": "function", "kind_evidence": {"basis": "declaration", "detail": "declared_form:function", "source_label": "function"}, "libraries": [], "macro_form": null, "macro_value_raw": null, "members": [], "module": null, "packing_pragma_raw": null, "page_class": "symbol_page", "parameters": [{"description": "I/O control code. This should be one of the values in the following table. Value Description IOCTL_HAL_GET_DEVICE_INFO Provides information about the systems parameter information (SPI) codes supported by SystemParametersInfo . IOCTL_HAL_GET_IP_ADDR Supports retrieval of target device Ethernet address information provided in the structure EDBG_ADDR . IOCTL_HAL_ILTIMING Supports ILTiming.exe functionality. IOCTL_HAL_INIT_RTC Supports resetting of the real-time clock by calling OEMSetRealTime . IOCTL_HAL_REBOOT Supports a warm boot of the target device. IOCTL_HAL_SEND_UDP Supports a call to EdbgSendUDP . IOCTL_EDBG_DEREGISTER_CLIENT Supports a call to the Ethernet debug function EdbgDeregister", "direction": null, "documented_values": [{"description": "Provides information about the systems parameter information (SPI) codes supported by SystemParametersInfo .", "token": "IOCTL_HAL_GET_DEVICE_INFO"}, {"description": "Supports retrieval of target device Ethernet address information provided in the structure EDBG_ADDR .", "token": "IOCTL_HAL_GET_IP_ADDR"}, {"description": "Supports ILTiming.exe functionality.", "token": "IOCTL_HAL_ILTIMING"}, {"description": "Supports resetting of the real-time clock by calling OEMSetRealTime .", "token": "IOCTL_HAL_INIT_RTC"}, {"description": "Supports a warm boot of the target device.", "token": "IOCTL_HAL_REBOOT"}, {"description": "Supports a call to EdbgSendUDP .", "token": "IOCTL_HAL_SEND_UDP"}, {"description": "Supports a call to the Ethernet debug function EdbgDeregisterClient .", "token": "IOCTL_EDBG_DEREGISTER_CLIENT"}, {"description": "Supports a call to the Ethernet debug function EdbgRegisterClient (Target Device) .", "token": "IOCTL_EDBG_REGISTER_CLIENT"}, {"description": "Supports a call to the Ethernet debug function EdbgRecv .", "token": "IOCTL_EDBG_RECV"}, {"description": "Supports a call to the Ethernet debug function EdbgSend .", "token": "IOCTL_EDBG_SEND"}, {"description": "Supports a call to the Ethernet debug function EdbgSetDebug (Target Device) .", "token": "IOCTL_EDBG_SET_DEBUG"}, {"description": "Returns information about physical memory.", "token": "IOCTL_QUERY_PHYSICALMEM"}, {"description": "Supports a call to SetKernelCommDev .", "token": "IOCTL_SET_KERNEL_COMM_DEV"}], "evidence_status": "documented", "name": "dwIoControlCode", "position": 1, "type": "DWORD", "type_raw": "DWORD dwIoControlCode"}, {"description": "Pointer to the input buffer that can contain additional information associated with the dwIoControlCode . When the parameter dwIoControlCode has the value IOCTL_HAL_GET_DEVICE_INFO, the parameter lpInBuf contains one of the SPI_* codes in the following table. Value Description SPI_GETPLATFORMTYPE String specifying the type of Windows CE device. SPI_GETOEMINFO String specifying OEM information that distinguishes this specific device from others of the same type.", "direction": null, "documented_values": [{"description": "String specifying the type of Windows CE device.", "token": "SPI_GETPLATFORMTYPE"}, {"description": "String specifying OEM information that distinguishes this specific device from others of the same type.", "token": "SPI_GETOEMINFO"}], "evidence_status": "documented", "name": "lpInBuf", "position": 2, "type": "LPVOID", "type_raw": "LPVOID lpInBuf"}, {"description": "Size in bytes of lpInBuf . For example, when dwIoControlCode is set to IOCTL_HAL_GET_DEVICE_INFO and the input buffer contains the SPI code, nInBufsize is set to the value 4.", "direction": null, "documented_values": [], "evidence_status": "derived+documented", "name": "nInBufSize", "position": 3, "type": "DWORD", "type_raw": "DWORD nInBufSize"}, {"description": "Pointer to the output buffer supplied by the caller. Your implementation should place the information requested by the parameters dwIoControlCode and lpInBuf into lpOutBuf, set lpBytesReturned to indicate the size of the data in lpOutbuf , and return TRUE . If the size of the requested information exceeds the buffer size specified by nOutBufSize , call SetLastError with the flag ERROR_INSUFFICIENT_BUFFER and return the value FALSE.", "direction": null, "documented_values": [], "evidence_status": "derived+documented", "name": "lpOutBuf", "position": 4, "type": "LPVOID", "type_raw": "LPVOID lpOutBuf"}, {"description": "Specifies the maximum number of bytes that can be returned in lpOutBuf . The caller sets this value.", "direction": null, "documented_values