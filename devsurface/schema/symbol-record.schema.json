{
 "$id": "https://github.com/kagurasumusun/wince-docs-corpus/devsurface/schema/symbol-record.schema.json",
 "$schema": "http://json-schema.org/draft-07/schema#",
 "additionalProperties": true,
 "description": "One record per symbol documented by one page of the Windows CE documentation corpus. Values are only ever copied from the source page or produced by a mapping table in tools/devsurface/vocab.py. A field the page does not state is null (or an empty array) and its name is listed in uncertainty.unknown_fields. See devsurface/METHODOLOGY.md.",
 "properties": {
  "abi": {
   "properties": {
    "architecture": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "data_model": {
     "type": [
      "string",
      "null"
     ]
    },
    "evidence_status": {
     "enum": [
      "unknown",
      "documented"
     ]
    },
    "name_decoration": {
     "type": [
      "string",
      "null"
     ]
    },
    "packing": {
     "type": [
      "string",
      "null"
     ]
    },
    "structure_layout": {
     "type": [
      "object",
      "null"
     ]
    }
   },
   "required": [
    "architecture",
    "data_model",
    "structure_layout",
    "packing",
    "name_decoration"
   ],
   "type": "object"
  },
  "calling_convention": {
   "properties": {
    "evidence_status": {
     "enum": [
      "unknown",
      "documented"
     ]
    },
    "value": {
     "type": "null"
    }
   },
   "required": [
    "value",
    "evidence_status"
   ],
   "type": "object"
  },
  "compaction": {
   "const": "v1",
   "description": "Rules applied by tools/devsurface/build_index.py; listed in devsurface/data/manifest.json."
  },
  "declaration": {
   "description": "Verbatim declaration text from the page (whitespace normalised). null when the page documents the symbol without printing a declaration; that page then carries 'declaration' in uncertainty.unknown_fields.",
   "maxLength": 2000,
   "type": [
    "string",
    "null"
   ]
  },
  "declaration_calling_convention_tokens": {
   "description": "Calling-convention macro tokens that appear inside the documented declaration. Presence is a documented fact; the ABI meaning is not concluded from it.",
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "declaration_glued_identifier_raw": {
   "type": [
    "string",
    "null"
   ]
  },
  "declaration_language": {
   "const": "c"
  },
  "declaration_origin": {
   "description": "Where the declaration block was read from, e.g. syntax_section, chm_syntax_pre, first_code_block, code_block_N, and the +glued_identifier / +split_identifier markers for source markup that splits a name.",
   "type": "string"
  },
  "declaration_status": {
   "description": "matched, matched_glued, candidate_mismatch:<name>, or the rejection reason of the best candidate.",
   "type": [
    "string",
    "null"
   ]
  },
  "deprecation_statements": {
   "description": "Sentences from the page that state removal or deprecation, quoted.",
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "derived_tags": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "documentation_role": {
   "description": "How the page presents the block the declaration was read from, decided by page structure only. 'example_code_fragment' means the block came from an unlabelled code block on a topic whose title is not the symbol: the record is kept, but the page is classed prose_page_code_fragment.",
   "enum": [
    "declaration_section",
    "unlabelled_block_symbol_topic",
    "example_code_fragment",
    "declaration_not_documented"
   ]
  },
  "documented_export_tokens": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "enumerators": {
   "items": {
    "properties": {
     "name": {
      "type": "string"
     },
     "value_raw": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "type": "array"
  },
  "evidence": {
   "items": {
    "properties": {
     "detail": {
      "type": "string"
     },
     "locator": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "type": "array"
  },
  "export": {
   "description": "Never filled by documentation extraction; kept explicit so consumers cannot mistake absence for a value.",
   "properties": {
    "decorated_name": {
     "type": "null"
    },
    "evidence_status": {
     "const": "unknown"
    },
    "name": {
     "type": "null"
    },
    "ordinal": {
     "type": "null"
    }
   },
   "required": [
    "name",
    "ordinal",
    "decorated_name"
   ],
   "type": "object"
  },
  "extraction": {
   "properties": {
    "corpus_revision": {
     "type": "string"
    },
    "extracted_on": {
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
     "type": "string"
    },
    "tool_version": {
     "type": "string"
    }
   },
   "required": [
    "tool_version",
    "extracted_on",
    "corpus_revision"
   ],
   "type": "object"
  },
  "header": {
   "properties": {
    "evidence_status": {
     "const": "documented"
    },
    "label_raw": {
     "description": "Label as the page prints it (Header, Defined in, Declared in, ...).",
     "type": "string"
    },
    "value": {
     "type": "string"
    },
    "value_raw": {
     "type": "string"
    }
   },
   "required": [
    "value",
    "label_raw",
    "evidence_status"
   ],
   "type": [
    "object",
    "null"
   ]
  },
  "id": {
   "description": "Stable id: sha1(source_id|page_id|symbol|declaration)[0:16].",
   "pattern": "^sym-[0-9a-f]{16}$",
   "type": "string"
  },
  "include": {
   "type": [
    "object",
    "null"
   ]
  },
  "kind": {
   "enum": [
    "function",
    "interface",
    "interface_method",
    "callback",
    "macro",
    "struct",
    "union",
    "enum",
    "type",
    "variable",
    "class",
    "constant",
    "ioctl",
    "unknown"
   ]
  },
  "kind_evidence": {
   "properties": {
    "basis": {
     "enum": [
      "declaration",
      "source_label",
      "title_form",
      "unknown"
     ]
    },
    "detail": {
     "type": [
      "string",
      "null"
     ]
    },
    "source_label": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "type": "object"
  },
  "libraries": {
   "items": {
    "properties": {
     "evidence_status": {
      "const": "documented"
     },
     "label_raw": {
      "type": "string"
     },
     "stated_absent": {
      "description": "The topic states there is none (e.g. 'Link Library: none').",
      "type": "boolean"
     },
     "value": {
      "type": [
       "string",
       "null"
      ]
     },
     "value_raw": {
      "type": "string"
     },
     "values": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "value",
     "values",
     "label_raw",
     "evidence_status"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "macro_form": {
   "enum": [
    "object_like",
    "function_like",
    null
   ]
  },
  "macro_value_raw": {
   "type": [
    "string",
    "null"
   ]
  },
  "members": {
   "description": "Members of a struct/union as printed in the declaration. Offsets are never recorded here (the documents do not state them).",
   "items": {
    "properties": {
     "bitfield_width_raw": {
      "type": [
       "string",
       "null"
      ]
     },
     "text_raw": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "type": "array"
  },
  "module": {
   "description": "Only set when a page labels the DLL/module. Almost always null.",
   "type": [
    "object",
    "null"
   ]
  },
  "packing_pragma_raw": {
   "type": [
    "string",
    "null"
   ]
  },
  "page_class": {
   "type": "string"
  },
  "parameters": {
   "items": {
    "properties": {
     "declaration_match": {
      "type": "boolean"
     },
     "description": {
      "description": "Shortened excerpt of the page's parameter description.",
      "type": [
       "string",
       "null"
      ]
     },
     "direction": {
      "description": "Only when the page states it, e.g. 'in', 'out', 'in, out', 'optional'.",
      "type": [
       "string",
       "null"
      ]
     },
     "documented_values": {
      "items": {
       "properties": {
        "description": {
         "type": "string"
        },
        "token": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "evidence_status": {
      "enum": [
       "documented",
       "derived",
       "derived+documented"
      ]
     },
     "name": {
      "type": [
       "string",
       "null"
      ]
     },
     "position": {
      "type": [
       "integer",
       "null"
      ]
     },
     "type": {
      "type": [
       "string",
       "null"
      ]
     },
     "type_raw": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "position",
     "name",
     "type",
     "direction",
     "description",
     "documented_values",
     "evidence_status"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "parse": {
   "properties": {
    "model": {
     "const": "c_declarator_v1"
    },
    "notes": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "status": {
     "enum": [
      "parsed",
      "partial",
      "no_declaration_documented",
      "unsupported"
     ]
    }
   },
   "required": [
    "model",
    "status",
    "notes"
   ],
   "type": "object"
  },
  "return_type": {
   "description": "Parsed mechanically from the declaration. null when the source markup makes the split ambiguous.",
   "type": [
    "string",
    "null"
   ]
  },
  "schema_version": {
   "const": 1
  },
  "scope": {
   "description": "Interface/class a member belongs to, when the page title carries 'Scope::Member'.",
   "type": [
    "string",
    "null"
   ]
  },
  "source": {
   "properties": {
    "document_last_updated": {
     "type": [
      "string",
      "null"
     ]
    },
    "page_id": {
     "type": "string"
    },
    "page_path": {
     "description": "Path inside this repository of the page the facts were read from.",
     "type": "string"
    },
    "source_id": {
     "description": "Key into devsurface/data/sources.json.",
     "type": "string"
    },
    "source_url": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "source_id",
    "page_path",
    "page_id",
    "source_url"
   ],
   "type": "object"
  },
  "symbol": {
   "description": "Symbol name as documented by the page title, or as declared by the documented declaration.",
   "minLength": 1,
   "type": "string"
  },
  "tag_name": {
   "type": [
    "string",
    "null"
   ]
  },
  "title_symbol": {
   "type": [
    "string",
    "null"
   ]
  },
  "title_symbol_matches_declaration": {
   "type": "boolean"
  },
  "uncertainty": {
   "properties": {
    "notes": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "unknown_fields": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "unknown_fields",
    "notes"
   ],
   "type": "object"
  },
  "version_availability": {
   "properties": {
    "statements": {
     "description": "Every availability statement the page prints, verbatim, with its mechanical normalisation.",
     "items": {
      "properties": {
       "field": {
        "enum": [
         "os_versions",
         "platform",
         "header",
         "include",
         "library",
         "module",
         "namespace",
         "assembly",
         "compatibility"
        ]
       },
       "label_raw": {
        "type": "string"
       },
       "normalized": {
        "properties": {
         "family_id": {
          "type": [
           "string",
           "null"
          ]
         },
         "family_label": {
          "type": [
           "string",
           "null"
          ]
         },
         "generation": {
          "type": [
           "string",
           "null"
          ]
         },
         "qualifier": {
          "description": "'and later' / 'or later' / 'and earlier' / 'only'",
          "type": [
           "string",
           "null"
          ]
         },
         "release_suffix": {
          "type": [
           "string",
           "null"
          ]
         },
         "status": {
          "enum": [
           "mapped",
           "partial",
           "unmapped"
          ]
         },
         "version_id": {
          "type": [
           "string",
           "null"
          ]
         },
         "version_number": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "family_id",
         "version_number",
         "version_id",
         "status"
        ],
        "type": "object"
       },
       "value_raw": {
        "type": "string"
       }
      },
      "required": [
       "field",
       "label_raw",
       "value_raw",
       "normalized"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "status": {
     "enum": [
      "documented_statement",
      "unknown"
     ]
    }
   },
   "required": [
    "statements",
    "status"
   ],
   "type": "object"
  }
 },
 "required": [
  "schema_version",
  "id",
  "symbol",
  "kind",
  "declaration",
  "declaration_origin",
  "parse",
  "header",
  "libraries",
  "module",
  "export",
  "calling_convention",
  "version_availability",
  "uncertainty",
  "source",
  "evidence",
  "extraction",
  "compaction",
  "documentation_role"
 ],
 "title": "Windows CE Development Surface symbol record (schema_version 1, compaction v1)",
 "type": "object"
}
