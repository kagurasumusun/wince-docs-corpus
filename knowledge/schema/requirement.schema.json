{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kagurasumusun/wince-docs-corpus/knowledge/schema/requirement.schema.json",
  "title": "Requirement record",
  "description": "One Header/Library/DLL/OS-version/platform statement of a page. knowledge/kb/requirements.jsonl(.gz).",
  "type": "object",
  "required": [
    "id",
    "entity",
    "page_id",
    "layer",
    "field",
    "label",
    "value",
    "key",
    "evidence",
    "source",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^r[0-9a-f]{12}$"
    },
    "entity": {
      "type": [
        "string",
        "null"
      ]
    },
    "page_id": {
      "type": "string"
    },
    "layer": {
      "enum": [
        "ce",
        "win32",
        "dotnet"
      ]
    },
    "field": {
      "enum": [
        "header",
        "library",
        "dll",
        "os_versions",
        "namespace",
        "assembly",
        "class",
        "type",
        "unicode_ansi",
        "requires",
        "module",
        "sysgen",
        "architecture",
        "component",
        "other"
      ],
      "description": "DERIVED: the page's own label mapped to a stable field. Keep 'label' as the evidence."
    },
    "label": {
      "type": "string",
      "description": "The label as printed (Header file:, Link Library:, Windows CE versions:, req.header, ...)."
    },
    "value": {
      "type": "string",
      "description": "The value as printed."
    },
    "evidence": {
      "type": "string",
      "description": "The label/value pair as it appears in the page."
    },
    "source": {
      "type": "object",
      "description": "See declaration.schema.json#/$defs/source.",
      "required": [
        "path",
        "page_id",
        "set",
        "title",
        "layer"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "page_id": {
          "type": "string"
        },
        "set": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "layer": {
          "enum": [
            "ce",
            "win32",
            "dotnet"
          ]
        }
      }
    },
    "key": {
      "type": "string",
      "description": "DERIVED grouping key: the value with trailing punctuation and whitespace removed (Winbase.h. -> Winbase.h). The verbatim value stays in 'value'."
    },
    "license": {
      "type": "string",
      "description": "Scope id in data/license-scopes.tsv governing this statement's page."
    }
  }
}
