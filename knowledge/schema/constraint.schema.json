{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kagurasumusun/wince-docs-corpus/knowledge/schema/constraint.schema.json",
  "title": "Constraint record",
  "description": "A sentence in which a page states a Windows CE restriction, limitation or extension. knowledge/kb/constraints.jsonl(.gz).",
  "type": "object",
  "required": [
    "id",
    "entity",
    "page_id",
    "layer",
    "pattern",
    "text",
    "source",
    "license",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^c[0-9a-f]{12}$"
    },
    "entity": {
      "type": [
        "string",
        "null"
      ]
    },
    "page_id": {
      "type": "string"
    },
    "layer": {
      "enum": [
        "ce",
        "win32",
        "dotnet"
      ]
    },
    "pattern": {
      "type": "string",
      "description": "Which conservative phrase matched (e.g. 'not supported')."
    },
    "text": {
      "type": "string",
      "description": "The sentence, verbatim. Nothing is summarized."
    },
    "source": {
      "type": "object",
      "description": "See declaration.schema.json#/$defs/source.",
      "required": [
        "path",
        "page_id",
        "set",
        "title",
        "layer"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "page_id": {
          "type": "string"
        },
        "set": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "layer": {
          "enum": [
            "ce",
            "win32",
            "dotnet"
          ]
        }
      }
    },
    "license": {
      "type": "string",
      "description": "Scope id in data/license-scopes.tsv governing this sentence's page."
    },
    "kind": {
      "type": "string",
      "enum": [
        "ce-restriction",
        "ce-note",
        "abi-note"
      ],
      "description": "ce-restriction: a Windows CE restriction/extension sentence; ce-note: the page's own labelled 'Windows CE Notes' paragraph (CE 1.0 Books Online), quoted whole because most of it states no restriction word; abi-note: a sentence stating an alignment, byte-order or pointer-size fact. The record's id is a hash over kind+page+text."
    }
  }
}
