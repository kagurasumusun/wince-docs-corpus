{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kagurasumusun/wince-docs-corpus/knowledge/schema/constraint.schema.json",
  "title": "Constraint record",
  "description": "A sentence in which a page states a Windows CE restriction, limitation or extension. knowledge/kb/constraints.jsonl(.gz).",
  "type": "object",
  "required": ["id", "entity", "page_id", "layer", "pattern", "text", "source"],
  "properties": {
    "id": {"type": "string", "pattern": "^c[0-9a-f]{12}$"},
    "entity": {"type": ["string", "null"]},
    "page_id": {"type": "string"},
    "layer": {"enum": ["ce", "win32", "dotnet"]},
    "pattern": {"type": "string", "description": "Which conservative phrase matched (e.g. 'not supported')."},
    "text": {"type": "string", "description": "The sentence, verbatim. Nothing is summarized."},
    "source": {"type": "object", "description": "See declaration.schema.json#/$defs/source.",
               "required": ["path", "page_id", "set", "title", "layer"],
               "properties": {"path": {"type": "string"}, "page_id": {"type": "string"},
                              "set": {"type": "string"}, "title": {"type": "string"},
                              "layer": {"enum": ["ce", "win32", "dotnet"]}}}
  }
}
